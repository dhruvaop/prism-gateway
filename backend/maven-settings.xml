<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <!-- Render's shared build IP is frequently throttled by repo.maven.apache.org
       with HTTP 429. The Google-hosted Maven Central mirror serves the same
       artifacts from a different CDN and keeps Docker builds reproducible. -->
  <mirrors>
    <mirror>
      <id>google-central-mirror</id>
      <name>Google Maven Central mirror</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
