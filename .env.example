# Change this before exposing the Compose deployment to other people.
DATABASE_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=jdbc:postgresql://db:5432/prism
DATABASE_USERNAME=prism
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_TTL_SECONDS=86400
PRISM_ROUTING_STRATEGY=failover

# Comma-separated browser origins allowed to call the gateway. Add the deployed
# console/chat origin, for example https://prism-console.pages.dev.
PRISM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Two-layer semantic cache. The short-term layer is process memory; the durable
# layer is opt-in per key. The daily purge and per-write caps keep a limited
# Postgres/Supabase plan bounded.
PRISM_CACHE_MEMORY_MAX_ENTRIES=500
PRISM_CACHE_MEMORY_TTL_SECONDS=900
PRISM_CACHE_MAX_ENTRIES=1000
PRISM_CACHE_MAX_ENTRIES_PER_KEY=200
PRISM_CACHE_MAX_ENTRY_BYTES=32768
PRISM_CACHE_MAX_HIT_ROWS=5000
PRISM_CACHE_RETENTION_HOURS=24
PRISM_CACHE_PURGE_ENABLED=true
PRISM_CACHE_PURGE_CRON="0 0 17 * * *"
PRISM_CACHE_PURGE_ZONE=Asia/Kolkata

# Optional OpenRouter provider. The mock providers remain the default primary routes.
OPENROUTER_API_KEY=
OPENROUTER_PREFER_AS_PRIMARY=false
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Task-specific free models used by model: "auto" when OpenRouter is primary.
# Empty simple/search values use OPENROUTER_MODEL; simple never uses :online.
OPENROUTER_MODEL_SIMPLE=
OPENROUTER_MODEL_SEARCH=
OPENROUTER_MODEL_RESEARCH=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_REASONING=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_MODEL_CODE=cohere/north-mini-code:free
# Set true to append :online to the web-search/simple model.
OPENROUTER_SEARCH_ONLINE=false
OPENROUTER_MAX_TOKENS=4096

# Optional Gemini fallback through Google's OpenAI-compatible endpoint.
# Set GEMINI_PREFER_AS_PRIMARY=true to route fast/smart traffic to Gemini first.
# gemini-3.1-flash-lite is a stable, low-latency model; any model available to
# your key can be used here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_PREFER_AS_PRIMARY=false

# Optional OpenAI provider. Any configured provider becomes a per-key routing
# profile in the admin console (openrouter, gemini, openai, mock, or auto).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Per-key routing: assign a profile in Admin > Virtual keys or Access. The key's
# profile decides which provider is tried first; fallbacks still protect the
# request. Seed examples use openrouter, gemini, and mock.

# Optional SMTP for password-reset email. Without a host the gateway returns
# the development reset link in the API response instead of sending mail.
# Gmail example: smtp.gmail.com:587, username/from = the Gmail address, and
# password = a 16-character Google App Password (not the normal password).
PRISM_MAIL_HOST=
PRISM_MAIL_PORT=587
PRISM_MAIL_USERNAME=
PRISM_MAIL_PASSWORD=
PRISM_MAIL_FROM=
PRISM_MAIL_STARTTLS=true
PRISM_MAIL_SSL=false
# Keep true locally so the form can show the link when mail is unavailable.
PRISM_MAIL_EXPOSE_RESET_LINK=true

# --- Free demo and Razorpay subscriptions ---
# New chat accounts get this many successful requests before the paywall.
PRISM_TRIAL_REQUESTS=5
PRISM_SUBSCRIPTION_DAYS=30
# Live keys charge real cards. Use rzp_test_ keys for local development.
RAZORPAY_MERCHANT_ID=
RAZORPAY_PAY_KEY_ID=
RAZORPAY_PAY_KEY_SECRET=
RAZORPAY_PRO_AMOUNT_PAISE=49900
RAZORPAY_ENTERPRISE_AMOUNT_PAISE=199900
RAZORPAY_CURRENCY=INR
# Paste the same value into the Razorpay Dashboard webhook settings.
RAZORPAY_WEBHOOK_SECRET=
# Optional endpoint notified once when a user uses the last free request.
PRISM_TRIAL_WEBHOOK_URL=
PRISM_TRIAL_WEBHOOK_SECRET=
